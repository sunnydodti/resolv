domain:
  name: "default"
blocks:
  - type: "primary"
    access: "write"
      repos:
        - source: "github"
          base_path: "github.com"
          repo_path: "org/repo"
  - type: "reference"
    access: "readonly"
      repos:
        - source: "gitlab"
          base_path: "gitlab.com"
          repo_path: "group/project"
  - type: "other"
    access: "readonly"
      repos:
        - source: "self-hosted"
          base_path: "https://git.mycompany.com"
          repo_path: "team/repo"